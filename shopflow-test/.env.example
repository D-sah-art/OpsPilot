# ==============================================================================
# ShopFlow Independent Microservice Platform (.env.example)
# ==============================================================================
ENVIRONMENT=production-simulation
APP_NAME=ShopFlow
VERSION=1.0.0
DEMO_MODE=true

# API Gateway
PORT=8000
HOST=0.0.0.0
GATEWAY_URL=http://127.0.0.1:8000

# PostgreSQL Simulation / In-Memory State
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=shopflow
POSTGRES_USER=shopflow_user
POSTGRES_PASSWORD=shopflow_dev_password

# Redis Simulation / Cache Tier
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Auth Token Configuration
JWT_SECRET_KEY=change-this-jwt-secret-in-production-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
