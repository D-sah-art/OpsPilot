# ==============================================================================
# OpsPilot & ShopFlow — Global Repository .gitignore
# ==============================================================================

# Python bytecode & compiler artifacts
__pycache__/
*.py[cod]
*.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Test, coverage & linter caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Node & Frontend build dependencies
node_modules/
*/node_modules/
frontend/node_modules/
shopflow-test/frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.vite/
*/.vite/
frontend/dist/
shopflow-test/frontend/dist/

# SQLite Database & Runtime State
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
opspilot.db
backend/opspilot.db

# Logs & Temporary Files
logs/
*/logs/
*.log
tmp/
temp/
cache/
.temp/

# Environment Variables & Secrets (Keep .env.example files)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!backend/.env.example
!shopflow-test/.env.example

# OS & Editor Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
