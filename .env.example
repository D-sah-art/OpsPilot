# ==============================================================================
# OpsPilot Global Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or use individual component .env files.
# The system works 100% offline out-of-the-box without external API keys.

# Application Ports & Hosts
APP_NAME=OpsPilot
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0

# ShopFlow Monitored Target Configuration
SHOPFLOW_BASE_URL=http://127.0.0.1:8000
SHOPFLOW_TIMEOUT_SECONDS=5.0

# OpsPilot SQLite Database
DATABASE_URL=sqlite:///./opspilot.db

# Optional LLM Root Cause Analysis (OpenAI / Gemini compatible endpoint)
# If left empty, OpsPilot automatically uses deterministic topological RCA
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15.0
LLM_TEMPERATURE=0.1

# Remediation Safety Policy Configuration
REMEDIATION_ALLOWLIST_PATH=config/remediation_allowlist.yaml
REMEDIATION_ENABLED=true
REMEDIATION_SIMULATION_MODE=true

# Hindsight Vectorize Persistent Memory System Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=opspilot-incidents-bank
HINDSIGHT_ENABLED=true
HINDSIGHT_TIMEOUT_SECONDS=5.0
