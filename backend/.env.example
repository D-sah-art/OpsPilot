# OpsPilot Configuration
APP_NAME=OpsPilot
ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0

# ShopFlow Monitored Target Configuration
SHOPFLOW_BASE_URL=http://localhost:8000
SHOPFLOW_TIMEOUT_SECONDS=5.0

# Database Configuration
DATABASE_URL=sqlite:///./opspilot.db

# LLM Root-Cause Analysis Configuration (OpenAI-compatible)
# Optional: If not provided or LLM fails, OpsPilot seamlessly uses evidence-based deterministic fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15.0
LLM_TEMPERATURE=0.1

# Hindsight Vectorize Persistent Memory System Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=opspilot-incidents-bank
HINDSIGHT_ENABLED=true
HINDSIGHT_TIMEOUT_SECONDS=5.0
